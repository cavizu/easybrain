# ==============================================================================
# EASYBRAIN v1.2 - PER-PROJECT PERSISTENT AGENT MEMORY & MCP SKILL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Storage Provider ('local' | 'supabase' | 'auto')
# ------------------------------------------------------------------------------
# - 'local'    : Zero-setup per-project local storage (<project>/.easybrain/memory.json).
# - 'supabase' : Your personal Supabase project (PostgreSQL + pgvector) isolated by project_id.
# - 'auto'     : Uses Supabase if SUPABASE_URL is set, otherwise uses local storage.
STORAGE_PROVIDER=auto

# Optional fallback directory if no project root is provided
LOCAL_STORAGE_PATH=./data/easybrain.memory.json

# ------------------------------------------------------------------------------
# 2. Personal Supabase Configuration (Optional - only for STORAGE_PROVIDER=supabase)
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. LLM & Embedding Configuration (Optional!)
# ------------------------------------------------------------------------------
# Leave OPENAI_API_KEY empty to run in BASIC MODE (100% local, zero API cost:
# structured project checkpoints, bootstrap, lexical search & raw log tracking).
# Set OPENAI_API_KEY to enable ENRICHED MODE (Librarian summaries + semantic vectors).
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Model used by Librarian Worker (e.g., gpt-4o-mini, llama-3.1-8b-instant, deepseek-chat)
LIBRARIAN_MODEL=gpt-4o-mini

# Optional separate Embedding Provider (falls back to OPENAI_API_KEY / OPENAI_BASE_URL)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ------------------------------------------------------------------------------
# 4. Automation & Context Budgets
# ------------------------------------------------------------------------------
# Auto-run Librarian in background after N unprocessed logs (Enriched Mode only; 0 = disable)
AUTO_CONSOLIDATE_THRESHOLD=10
RECENT_MESSAGES_LIMIT=6
BOOTSTRAP_MAX_TOKENS=1000

# ------------------------------------------------------------------------------
# 5. Standalone REST API Configuration (Optional)
# ------------------------------------------------------------------------------
PORT=3000
HOST=127.0.0.1
# Required if exposing HOST beyond 127.0.0.1
API_KEY=
