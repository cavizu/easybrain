{
  "name": "easybrain",
  "version": "1.2.1",
  "description": "EasyBrain: Per-project persistent memory engine, MCP server, and Agent Skill (Local Zero-Config or Personal Supabase + pgvector).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "sql",
    "skills",
    "README.md",
    "README.pt-BR.md",
    "LICENSE"
  ],
  "bin": {
    "easybrain": "dist/cli/index.js",
    "easybrain-api": "dist/api/server.js",
    "easybrain-mcp": "dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/api/server.js",
    "start:mcp": "node dist/mcp/server.js",
    "dev:server": "tsx src/api/server.ts",
    "dev:mcp": "tsx src/mcp/server.ts",
    "cli": "tsx src/cli/index.ts",
    "demo": "tsx src/examples/demo.ts",
    "test": "tsx --test tests/memory.test.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "ai-agent",
    "memory",
    "mcp",
    "agent-skill",
    "claude-code",
    "antigravity",
    "cursor",
    "long-term-memory",
    "pgvector",
    "supabase",
    "local-first"
  ],
  "author": "Celso Eduardo",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "openai": "^4.86.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
